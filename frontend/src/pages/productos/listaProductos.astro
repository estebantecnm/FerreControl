---
import MainLayout from '../../layouts/MainLayout.astro';
import ProductosList from '../../components/vue/ProductosList.vue';
---

<MainLayout title="Gestión de Productos - FerreControl">
  <main class="container mx-auto p-4">
    <header class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-black text-slate-800 uppercase tracking-tight">Gestión de Productos</h1>
        <p class="text-slate-500 text-sm">Visualiza, edita y gestiona las especificaciones de tu inventario.</p>
      </div>
      
      <a 
        href="/productos/registrarProducto" 
        class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-bold flex items-center gap-2 shadow-lg shadow-blue-200 transition-all uppercase text-sm"
      >
        <span>+</span> Nuevo Producto
      </a>
    </header>
    <ProductosList client:load />
  </main>
</MainLayout>